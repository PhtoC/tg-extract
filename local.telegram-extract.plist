<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.telegram-extract</string>
    <key>WorkingDirectory</key>
    <string>/Users/phtoc/telegram-extract</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-i</string>
        <string>-s</string>
        <string>/Users/phtoc/.local/bin/uv</string>
        <string>run</string>
        <string>python</string>
        <string>-u</string>
        <string>-m</string>
        <string>tgextract.bot</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/phtoc/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/phtoc</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/phtoc/telegram-extract/data/service.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/phtoc/telegram-extract/data/service.log</string>
</dict>
</plist>
