# 从 https://my.telegram.org 拿
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef
# 从 @BotFather 拿
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 允许使用这个 bot 的 Telegram user id，逗号分隔；首次登录会自动写入
ALLOWED_USER_IDS=
# bot 直传上限（MB）。超过的会自动存到你的收藏夹
BOT_MAX_MB=50
# 1 = 下载的文件保留在 data/tmp，0 = 5 分钟后自动清理
KEEP_FILES=0
